      "id": "anthropic",
      "repo": "https://github.com/anthropics/skills",
      "license": "Per-skill LICENSE.txt files; THIRD_PARTY_NOTICES.md at the repo root",
      "verified": "2026-11-10",
      "attribution": "Anthropic (anthropics/skills)",
      "includeGlobs": ["skills/*"]
    },
    {
      "id": "superpowers",
      "repo": "https://github.com/obra/superpowers",
      "license": "MIT",
      "verified": "2026-11-10",
      "attribution": "Jesse Vincent (obra/superpowers)",
