    },
    {
      "id": "wshobson-agents",
      "repo": "https://github.com/wshobson/agents",
      "license": "MIT",
      "verified": "2026-11-10",
      "attribution": "wshobson/agents",
      "includeGlobs": ["plugins/*/skills/*"]
    },
    {
      "id": "cloudflare",
      "repo": "https://github.com/cloudflare/skills",
